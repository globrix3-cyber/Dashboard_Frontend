# ─────────────────────────────────────────────────────────
#  Globrixa Frontend — Environment Variables
#  Copy this file to .env and fill in values for your env.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
# Leave empty in development — Vite's dev proxy handles /api → localhost:8000.
# Required in production — set to your deployed API origin:
VITE_API_URL=https://api.globrixa.com
